{
	"$profile": "pbe-zh",
	"common": {
		"forceExtractFile": false,
		"skipExtract": false,
		"saveWithShort": true,
		"sourceResource": "client",
		"levelSoundEffect": "no",
		"forceUseBaseSkinFiles": false,
		"format": "wav",
		"skipSaveDictation": true,
		"fileVGMStreamCLI": ".../vgmstream-cli.exe",
		"-fileZSTD": ".../zstd.exe",
		"-fileRExtractorConsole": ".../RExtractorConsole.exe",
		"dirExportVoice": ".../audio/vo/wem",
		"dirConversionVoice": ".../audio/vo/wav",
		"convertSFX": false,
		"dirExportSoundEffect": ".../audio/sfx",
		"dirConversionSoundEffect": ".../audio/sfx-wav",
		"dirExportVoiceEvent": ".../events/vo",
		"dirExportSoundEffectEvent": ".../events/sfx",
		"dirDictations": ".../lol-vo-lines-dictation/dictation",
		"dirAutogen": ".../lol-vo-aeproject-autogen"
	},
	"pbe": {
		"$base": "common",
		"dirGameClient": ".../Riot Games/League of Legends (PBE)",
		"dirGameDataPlugin": ".../Riot Games/League of Legends (PBE)/Plugins/rcp-be-lol-game-data"
	},
	"cn": {
		"$base": "common",
		"dirGameClient": ".../WeGameApps/英雄联盟",
		"dirGameDataPlugin": ".../WeGameApps/英雄联盟/LeagueClient/Plugins/rcp-be-lol-game-data"
	}
}
